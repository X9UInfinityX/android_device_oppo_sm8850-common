From: X9UInfinityX <noreply@github.com>
Subject: [PATCH] viper4android: initialize AIDL driver status on service start

Based on ViPER4Android 2.0.1. The native AIDL driver only publishes its
status after the first AudioEffect instance is created. Probe it once while
disabled so the UI can detect the installed driver before Master is enabled.

Keep the shared-memory channel under /data/vendor/audiox, where vendor init
creates and labels it for the app and audio HAL.
---
 .../viper4android/service/ViperService.kt     | 19 +++++++++++++++++++
 .../llsl/viper4android/viper/ConfigChannel.kt |  8 ++++----
 2 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/com/llsl/viper4android/service/ViperService.kt b/app/src/main/java/com/llsl/viper4android/service/ViperService.kt
index 389e0d1..8ae3a70 100644
--- a/app/src/main/java/com/llsl/viper4android/service/ViperService.kt
+++ b/app/src/main/java/com/llsl/viper4android/service/ViperService.kt
@@ -85,6 +85,9 @@ class ViperService : LifecycleService() {
         FileLogger.i("Service", "Service created")
         lifecycleScope.launch {
             useAidlTypeUuid = repository.aidlMode
+            if (useAidlTypeUuid) {
+                probeAidlDriver()
+            }
             globalMode = repository.getBooleanPreference(ViperRepository.PREF_GLOBAL_MODE).first()
             masterEnabled = repository.getBooleanPreference(ViperRepository.PREF_MASTER_ENABLE).first()
             if (masterEnabled) {
@@ -98,6 +101,22 @@ class ViperService : LifecycleService() {
         }
     }
 
+    /**
+     * Instantiate the AIDL effect once so the native driver publishes its status even when
+     * Master is disabled. Keep the probe disabled and release it immediately; a real global or
+     * per-session effect is created later when the user enables processing.
+     */
+    private fun probeAidlDriver() {
+        val probe = ViperEffect(0, ViperEffect.EFFECT_TYPE_UUID_AIDL)
+        if (!probe.create()) {
+            FileLogger.e("Service", "AIDL driver probe failed")
+            return
+        }
+        probe.enabled = false
+        probe.release()
+        FileLogger.i("Service", "AIDL driver probe completed")
+    }
+
     override fun onBind(intent: Intent): IBinder {
         super.onBind(intent)
         return binder
diff --git a/app/src/main/java/com/llsl/viper4android/viper/ConfigChannel.kt b/app/src/main/java/com/llsl/viper4android/viper/ConfigChannel.kt
index e68ef27..585f8ae 100644
--- a/app/src/main/java/com/llsl/viper4android/viper/ConfigChannel.kt
+++ b/app/src/main/java/com/llsl/viper4android/viper/ConfigChannel.kt
@@ -23,9 +23,9 @@ data class FileDriverStatus(
 )
 
 object ConfigChannel {
-    private const val SHM_STATUS_PATH = "/data/local/tmp/v4a/shm_status.bin"
-    private const val SHM_PARAMS_PATH = "/data/local/tmp/v4a/shm_params.bin"
-    private const val SHM_BULK_PATH = "/data/local/tmp/v4a/shm_bulk.bin"
+    private const val SHM_STATUS_PATH = "/data/vendor/audiox/shm_status.bin"
+    private const val SHM_PARAMS_PATH = "/data/vendor/audiox/shm_params.bin"
+    private const val SHM_BULK_PATH = "/data/vendor/audiox/shm_bulk.bin"
 
     private const val SHM_MAGIC = 0x534D3456 // 'V4MS' little-endian
     private const val FORMAT_VERSION = 5
@@ -94,7 +94,7 @@ object ConfigChannel {
 
     private fun createShmViaSu() {
         RootShell.exec(
-            "mkdir -p /data/local/tmp/v4a && " +
+            "mkdir -p /data/vendor/audiox && " +
                 "[ ! -f $SHM_STATUS_PATH ] && dd if=/dev/zero of=$SHM_STATUS_PATH bs=$STATUS_SHM_SIZE count=1 2>/dev/null; " +
                 "[ ! -f $SHM_PARAMS_PATH ] && dd if=/dev/zero of=$SHM_PARAMS_PATH bs=$PARAM_SHM_SIZE count=1 2>/dev/null; " +
                 "[ ! -f $SHM_BULK_PATH ]   && dd if=/dev/zero of=$SHM_BULK_PATH bs=$BULK_SHM_SIZE count=1 2>/dev/null; " +
-- 
2.0.1
